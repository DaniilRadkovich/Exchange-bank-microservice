              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_from\": \"{{accountFrom}}\",\n  \"account_to\": \"{{accountTo}}\",\n  \"currency_shortname\": \"USD\",\n  \"sum\": 500.00,\n  \"expense_category\": \"service\",\n  \"datetime\": \"2022-01-03T10:00:00Z\"\n}",
              "options": {
