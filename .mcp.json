{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "PGHOST": "${PGHOST:-localhost}",
        "PGPORT": "${PGPORT:-5433}",
        "PGDATABASE": "${PGDATABASE:-exchange}",
        "PGUSER": "${PGUSER:-exchange_readonly}",
        "PGPASSWORD": "${PGPASSWORD}"
      }
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    }
  }
}